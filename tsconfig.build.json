{
  "compilerOptions": {
    "allowImportingTsExtensions": false,
    "allowJs": false,
    "checkJs": false,
    "customConditions": ["docmark-extension-sass"],
    "declarationMap": false,
    "noEmitOnError": true,
    "outDir": "dist",
    "rewriteRelativeImportExtensions": true,
    "rootDir": "src",
    "sourceMap": false,
    "target": "es2024"
  },
  "exclude": ["**/__mocks__/**", "**/__tests__/**"],
  "extends": "./tsconfig.json",
  "files": ["src/typings/@flex-development/docmark-util-types/index.d.mts"],
  "include": ["dist/**/*", "src/**/**.mts"]
}
